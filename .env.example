# Required: secret for Payload JWT signing — must be at least 32 characters
PAYLOAD_SECRET=your-secret-here-replace-with-32-plus-chars

# Required: Postgres connection string
# Local dev: use Docker Compose values below
DATABASE_URL=postgresql://payload:localdev@localhost:5432/civpulse_cms

# Required: Cloudflare R2 storage (S3-compatible)
# Used by @payloadcms/storage-s3 for Media collection uploads
R2_ENDPOINT=your-account-id.r2.cloudflarestorage.com
R2_BUCKET=your-bucket-name
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_PUBLIC_URL=https://media.yourdomain.com

# Required: webhook signing secret — must be at least 32 characters
# Used for HMAC signing between Payload and run-api
WEBHOOK_SECRET=your-webhook-secret-here-replace-with-32-plus-chars
